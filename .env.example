# ========================================
# MONGODB CONFIGURATION
# ========================================
# Credentials (utilisés par docker-compose.yml)
MONGO_USERNAME=proterra_admin
MONGO_PASSWORD=ProterraSecure2024!
MONGO_DATABASE=proterra

# URI de connexion (utilisé par Payload CMS)
# ⚠️ IMPORTANT : dotenv ne supporte pas l'interpolation ${...}
MONGODB_URI=mongodb://proterra_admin:ProterraSecure2024!@localhost:27017/proterra?authSource=admin

# ========================================
# PAYLOAD CMS CONFIGURATION
# ========================================
# Clé secrète (CHANGEZ-LA !)
PAYLOAD_SECRET=changez-moi-par-une-cle-secrete-de-minimum-32-caracteres-tres-longue-et-aleatoire-utilisez-openssl-rand-base64-32

# Port du serveur Payload Admin (Express standalone)
PAYLOAD_PORT=3001

# URL du serveur Payload (utilisée par l'admin panel pour les appels API)
PAYLOAD_SERVER_URL=http://localhost:3001

# ========================================
# NEXT.JS FRONTEND CONFIGURATION
# ========================================
# URL publique du site Next.js
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# URL de l'API Payload (pour que Next.js appelle l'API Payload)
NEXT_PUBLIC_PAYLOAD_URL=http://localhost:3001

# Email (Resend - optionnel)
# RESEND_API_KEY=your-resend-api-key
# EMAIL_FROM=noreply@proterra-environnement.com

# Google Maps (optionnel)
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Analytics (optionnel)
# NEXT_PUBLIC_GA_ID=
