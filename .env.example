# Database (PostgreSQL recommandé pour production)
DATABASE_URI=postgres://user:password@localhost:5432/proterra

# Payload CMS
PAYLOAD_SECRET=your-super-secret-key-change-this-in-production

# Next.js
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Email (Resend ou SendGrid)
RESEND_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM=noreply@proterra-environnement.com

# Google Maps (optionnel)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Analytics (optionnel)
NEXT_PUBLIC_GA_ID=
